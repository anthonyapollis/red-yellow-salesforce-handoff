model Model
	culture: en-ZA
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-ZA
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DaxQueryView","TMDL","DevMode"]

annotation PBI_QueryOrder = ["_Measures","dim_date","dim_contact","dim_offering","dim_campaign","fct_campaign_performance","fct_admissions_funnel","fct_student_progress_weekly","fct_lead_conversion","dq_issue_log","dq_summary","programme","intake","programme_enquiry","application","enrolment","student","campaign_member","sf_account","sf_contact","sf_lead","sf_opportunity","ml_lead_propensity","ml_withdrawal_risk"]

ref table _Measures
ref table dim_date
ref table dim_contact
ref table dim_offering
ref table dim_campaign
ref table fct_campaign_performance
ref table fct_admissions_funnel
ref table fct_student_progress_weekly
ref table fct_lead_conversion
ref table dq_issue_log
ref table dq_summary
ref table programme
ref table intake
ref table programme_enquiry
ref table application
ref table enrolment
ref table student
ref table campaign_member
ref table sf_account
ref table sf_contact
ref table sf_lead
ref table sf_opportunity
ref table ml_lead_propensity
