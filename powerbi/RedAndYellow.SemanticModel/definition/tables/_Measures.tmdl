table _Measures
	lineageTag: 3922aa05-75ae-41fc-be1c-3e3a62f8ab90

	measure Leads = COUNTROWS(fct_lead_conversion)
		formatString: #,0
		displayFolder: 01 Marketing
		lineageTag: 37310741-664c-4c95-b9f9-f7e5da6b1cf2

	measure Contacts = COUNTROWS(dim_contact)
		formatString: #,0
		displayFolder: 01 Marketing
		lineageTag: 8dc82d4a-bc89-496e-a52d-5e43c06b9798

	measure 'Marketing Spend' = SUM(dim_campaign[spend_zar])
		formatString: "R"#,0
		displayFolder: 01 Marketing
		lineageTag: 13f6affb-2ecc-4b9a-8b6d-968d78e8a1e1

	measure 'Campaign Members' = SUM(fct_campaign_performance[members])
		formatString: #,0
		displayFolder: 01 Marketing
		lineageTag: 8a1df7f9-2867-43b1-b441-60ece180412a

	measure 'Engaged Members' = SUM(fct_campaign_performance[engaged_members])
		formatString: #,0
		displayFolder: 01 Marketing
		lineageTag: 03d2a035-04b2-46fa-8c5b-bbc9d8b1243d

	measure 'Engagement Rate' = DIVIDE([Engaged Members], [Campaign Members])
		formatString: 0.0%
		displayFolder: 01 Marketing
		lineageTag: 3c411a6d-e36a-4602-8848-e575f7840ef3

	measure 'Enrolled Revenue' = SUM(fct_campaign_performance[enrolled_revenue_zar])
		formatString: "R"#,0
		displayFolder: 01 Marketing
		lineageTag: 24e10775-da8a-47ad-b31b-6fa3a24fa05a

	measure 'Cost per Enrolment' = DIVIDE([Marketing Spend], [Campaign Enrolments])
		formatString: "R"#,0
		displayFolder: 01 Marketing
		lineageTag: 7b2fd743-35e7-4920-85f8-bd1086bbe6f7

	measure 'Return on Ad Spend' = DIVIDE([Enrolled Revenue], [Marketing Spend])
		formatString: 0.00
		displayFolder: 01 Marketing
		lineageTag: 5d4f5127-fe64-45a0-b4b7-452785a04558

	measure 'Campaign Enrolments' = SUM(fct_campaign_performance[enrolments])
		formatString: #,0
		displayFolder: 01 Marketing
		lineageTag: a3012660-52c9-4d2f-a36c-a8a13a7a7fd2

	measure Opportunities = COUNTROWS(fct_admissions_funnel)
		formatString: #,0
		displayFolder: 02 Admissions
		lineageTag: 007e9511-eb7c-42b7-9db7-fcd855c814fb

	measure Applications = CALCULATE(COUNTROWS(fct_admissions_funnel), NOT ISBLANK(fct_admissions_funnel[application_external_id]))
		formatString: #,0
		displayFolder: 02 Admissions
		lineageTag: e4bcbeda-78f8-474c-8ffa-45417b3d5ac2

	measure Enrolments = SUM(fct_admissions_funnel[is_enrolled])
		formatString: #,0
		displayFolder: 02 Admissions
		lineageTag: 3d63cde1-26a4-4bec-af20-f9b00359e6c3

	measure 'Opportunity to Application' = DIVIDE([Applications], [Opportunities])
		formatString: 0.0%
		displayFolder: 02 Admissions
		lineageTag: 25f69723-ca15-4fad-ba7b-8b423ce2f0dc

	measure 'Application to Enrolment' = DIVIDE([Enrolments], [Applications])
		formatString: 0.0%
		displayFolder: 02 Admissions
		lineageTag: a8554c27-5f30-497a-b026-a69c909cabd9

	measure 'Opportunity to Enrolment' = DIVIDE([Enrolments], [Opportunities])
		formatString: 0.0%
		displayFolder: 02 Admissions
		lineageTag: 3c9035cf-fe5e-4a62-a1b6-845810af7526

	measure 'Pipeline Value' = SUM(fct_admissions_funnel[expected_value_zar])
		formatString: "R"#,0
		displayFolder: 02 Admissions
		lineageTag: e831bd71-04e4-4bcd-b165-89fe78dd89b9

	measure 'Agreed Fees' = SUM(fct_admissions_funnel[agreed_fee_zar])
		formatString: "R"#,0
		displayFolder: 02 Admissions
		lineageTag: ed47b649-2b0a-4f11-a1f8-c2e9bad5b66d

	measure 'Average Discount' = AVERAGE(fct_admissions_funnel[discount_pct])
		formatString: 0.0
		displayFolder: 02 Admissions
		lineageTag: 6a02cf32-99bb-44f8-84f8-f3a5bc52de41

	measure 'Avg Days to Decision' = AVERAGE(fct_admissions_funnel[days_to_decision])
		formatString: #,0.0
		displayFolder: 02 Admissions
		lineageTag: 76b69c77-df28-4239-8987-1c5941f7224d

	measure 'Tracked Weeks' = COUNTROWS(fct_student_progress_weekly)
		formatString: #,0
		displayFolder: 03 Student Success
		lineageTag: 40f7b8ac-e776-424b-b57f-a1c23e36e89b

	measure 'Students At Risk' = CALCULATE(DISTINCTCOUNT(fct_student_progress_weekly[enrolment_external_id]), fct_student_progress_weekly[is_at_risk] = 1)
		formatString: #,0
		displayFolder: 03 Student Success
		lineageTag: 35421a7b-a19e-48ff-b044-b18b39b049d8

	measure 'At Risk Rate' = DIVIDE(SUM(fct_student_progress_weekly[is_at_risk]), [Tracked Weeks])
		formatString: 0.0%
		displayFolder: 03 Student Success
		lineageTag: e3cdddc2-0f64-487a-aad7-9809458e1a8b

	measure 'Avg Attendance' = AVERAGE(fct_student_progress_weekly[attendance_pct])
		formatString: 0.0
		displayFolder: 03 Student Success
		lineageTag: 89c196a0-a8cb-4a9b-8267-0e5571a2eacb

	measure 'Avg Assessment' = AVERAGE(fct_student_progress_weekly[assessment_average_pct])
		formatString: 0.0
		displayFolder: 03 Student Success
		lineageTag: e82578de-70cf-4bc6-9bc9-5e4527d2f502

	measure 'Overdue Assignments' = SUM(fct_student_progress_weekly[overdue_assignments])
		formatString: #,0
		displayFolder: 03 Student Success
		lineageTag: 15dd09a4-2358-4f33-bf48-2e96d2f3569b

	measure 'Quality Issues' = COUNTROWS(dq_issue_log)
		formatString: #,0
		displayFolder: 04 Data Quality
		lineageTag: 22b1fb4c-ecbd-4112-974f-ed2830ad7aee

	measure 'Duplicate Contacts' = CALCULATE([Quality Issues], dq_issue_log[issue_code] = "duplicate_person")
		formatString: #,0
		displayFolder: 04 Data Quality
		lineageTag: 894df984-608d-4f02-be32-8466bad15d29

	measure 'Contacts With Duplicates' = CALCULATE(COUNTROWS(dim_contact), dim_contact[has_duplicates] = 1)
		formatString: #,0
		displayFolder: 04 Data Quality
		lineageTag: 998e1555-161e-4733-a5f6-1758f3b578c2

	measure 'Duplicate Rate' = DIVIDE([Contacts With Duplicates], [Contacts])
		formatString: 0.0%
		displayFolder: 04 Data Quality
		lineageTag: 55e2b40d-1245-42ca-bb48-4f23baea3084

	measure 'Unresolved Provinces' = CALCULATE(COUNTROWS(dim_contact), dim_contact[province] = "Unknown")
		formatString: #,0
		displayFolder: 04 Data Quality
		lineageTag: e30fbd5f-97a7-41b5-8138-4e15e228ddde

	column _placeholder
		dataType: string
		isHidden
		lineageTag: 92c285b6-5bf2-4329-80eb-9bdd231b4cfb
		summarizeBy: none
		sourceColumn: _placeholder

	partition _Measures = m
		mode: import
		source =
				let
				    Source = #table(type table [_placeholder = text], {{""}})
				in
				    Source

